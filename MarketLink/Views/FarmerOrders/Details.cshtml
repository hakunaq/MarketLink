@model Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">Pre-orders</a></li>
        <li class="breadcrumb-item active">#@Model.Id</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h4 class="mb-0">Order #@Model.Id</h4>
                    <partial name="_OrderStatusBadge" model="Model.Status" />
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Quantity @item.Product?.Unit</td>
                                    <td>@item.UnitPrice.ToString("0.00")</td>
                                    <td class="fw-semibold">@item.LineTotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Total (paid at pickup)</th><th colspan="1">@Model.TotalAmount.ToString("0.00")</th></tr>
                        </tfoot>
                    </table>
                </div>
                @if (!string.IsNullOrEmpty(Model.CustomerNote))
                {
                    <p class="small text-muted mt-2 mb-0"><strong>Customer note:</strong> @Model.CustomerNote</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-2">Customer</h6>
                <p class="small mb-1"><i class="bi bi-person me-1 text-success"></i>@(Model.Customer?.FullName ?? Model.Customer?.Email)</p>
                <p class="small mb-0"><i class="bi bi-envelope me-1 text-success"></i>@Model.Customer?.Email</p>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-2">Pickup</h6>
                <p class="small mb-1"><i class="bi bi-calendar me-1 text-success"></i>@Model.PickupDate.ToString("dd MMM yyyy")</p>
                <p class="small mb-1"><i class="bi bi-clock me-1 text-success"></i>@Model.PickupTimeSlot</p>
                @if (Model.Market != null)
                {
                    <p class="small mb-0"><i class="bi bi-geo-alt me-1 text-success"></i>@Model.Market.Name</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Update status</h6>
                <div class="d-grid gap-2">
                    @if (Model.Status == OrderStatus.Placed)
                    {
                        <form asp-action="Accept" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
                            <button class="btn btn-success btn-sm"><i class="bi bi-check2"></i> Accept order</button></form>
                        <form asp-action="Decline" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-x-lg"></i> Decline order</button></form>
                    }
                    else if (Model.Status == OrderStatus.Accepted)
                    {
                        <form asp-action="Ready" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
                            <button class="btn btn-warning btn-sm"><i class="bi bi-bag-check"></i> Mark ready for pickup</button></form>
                    }
                    else if (Model.Status == OrderStatus.ReadyForPickup)
                    {
                        <form asp-action="Complete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
                            <button class="btn btn-green btn-sm"><i class="bi bi-clipboard-check"></i> Mark completed</button></form>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">This order is @Model.Status.ToString(). No further action needed.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
