@model Product
<div class="card ml-product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/products/placeholder.svg" : Model.ImageUrl)"
             class="ml-product-img" alt="@Model.Name" />
    </a>
    <div class="card-body p-3">
        <span class="ml-badge-cat">@Model.Category?.Name</span>
        <h6 class="mt-2 mb-1 fw-semibold">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">@Model.Name</a>
        </h6>
        <p class="small text-muted mb-2">
            <i class="bi bi-shop"></i> @Model.Farmer?.StallName
        </p>
        <div class="d-flex justify-content-between align-items-center">
            <span class="ml-price">@Model.Price.ToString("0.00") <small class="text-muted fw-normal">/ @Model.Unit</small></span>
            @if (Model.IsSoldOut)
            {
                <span class="badge bg-secondary">Sold out</span>
            }
            else
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-sm btn-green" title="Add to cart">
                        <i class="bi bi-cart-plus"></i>
                    </button>
                </form>
            }
        </div>
    </div>
</div>
