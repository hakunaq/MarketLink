@using System.Security.Claims
@using MarketLink.Services
@using Microsoft.AspNetCore.Identity
@inject ICartService Cart
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketLink</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark ml-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-basket2-fill me-1"></i> MarketLink
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Markets" asp-action="Index">Markets</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Farmers" asp-action="Index">Farmers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Markets" asp-action="Map"><i class="bi bi-geo-alt"></i> Map</a></li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier)!;
                        var isCustomer = User.IsInRole(Roles.Customer);
                        var isFarmer = User.IsInRole(Roles.Farmer);
                        var isAdmin = User.IsInRole(Roles.Admin);

                        @if (isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart3"></i> Cart
                                    <span class="badge rounded-pill bg-warning text-dark ml-cart-badge">@Cart.GetCount()</span>
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell"></i>
                                <span class="badge rounded-pill bg-danger ml-notif-badge d-none">0</span>
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @(UserManager.GetUserName(User))
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                }
                                @if (isFarmer)
                                {
                                    <li><a class="dropdown-item" asp-controller="Farmer" asp-action="Index"><i class="bi bi-shop me-2"></i>Farmer Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="FarmerProducts" asp-action="Index"><i class="bi bi-box-seam me-2"></i>My Products</a></li>
                                    <li><a class="dropdown-item" asp-controller="FarmerOrders" asp-action="Index"><i class="bi bi-receipt me-2"></i>Pre-orders</a></li>
                                }
                                @if (isCustomer)
                                {
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-house-heart me-2"></i>My Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Favorites"><i class="bi bi-heart me-2"></i>Favorites</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile"><i class="bi bi-gear me-2"></i>My Profile</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm ms-lg-2 fw-semibold" asp-controller="Account" asp-action="RegisterCustomer">Join Free</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        <div class="container py-4">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="ml-footer mt-auto py-4">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-4">
                    <h6 class="fw-bold"><i class="bi bi-basket2-fill me-1"></i> MarketLink</h6>
                    <p class="small mb-0">Connecting local farmers and customers directly — browse, reserve and pick up fresh produce at your nearest market.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Explore</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Markets" asp-action="Index">Markets</a></li>
                        <li><a asp-controller="Farmers" asp-action="Index">Farmers</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Products</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">About</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        <li><a asp-controller="Account" asp-action="RegisterFarmer">Sell on MarketLink</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-light opacity-25" />
            <p class="small text-center mb-0">&copy; @DateTime.Now.Year MarketLink — eGreen Basket. Payment is settled in person at pickup.</p>
        </div>
    </footer>

    <partial name="_AiWidget" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
