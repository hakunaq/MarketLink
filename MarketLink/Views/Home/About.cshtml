@{
    ViewData["Title"] = "About Us";
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <h2 class="section-title mb-3"><i class="bi bi-people-fill me-2"></i>About MarketLink</h2>
        <div class="card mb-4">
            <div class="card-body">
                <p class="lead">MarketLink connects local farmers-market farmers directly with customers.</p>
                <p>
                    Shoppers increasingly want fresh, seasonal, locally grown produce — but they rarely know in
                    advance which farmers will be at a market, what stock they have, or at what price. Availability
                    is usually shared informally through chalkboards or word of mouth, so customers often make a trip
                    only to find an item sold out or a stall closed.
                </p>
                <p>
                    MarketLink centralises all of that. Farmers publish their weekly stock, pricing and pickup windows,
                    and manage incoming pre-orders. Customers discover nearby markets, browse what is available,
                    reserve items for pickup, track orders and leave feedback — all in one place.
                </p>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body text-center">
                    <i class="bi bi-basket2-fill fs-1 text-success"></i>
                    <h6 class="mt-2 fw-bold">For Customers</h6>
                    <p class="small text-muted mb-0">Browse markets, reserve produce, pay at pickup, save favorites and review farmers.</p>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body text-center">
                    <i class="bi bi-shop fs-1 text-success"></i>
                    <h6 class="mt-2 fw-bold">For Farmers</h6>
                    <p class="small text-muted mb-0">Publish weekly stock, manage pre-orders, map your stall and see sales insights.</p>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100"><div class="card-body text-center">
                    <i class="bi bi-tree fs-1 text-success"></i>
                    <h6 class="mt-2 fw-bold">eGreen Basket</h6>
                    <p class="small text-muted mb-0">Fewer wasted trips, better harvest planning, stronger local food communities.</p>
                </div></div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-mortarboard-fill me-2 text-success"></i>The Team</h5>
                <p class="small text-muted">
                    MarketLink was designed and built as a student end-to-end web solution. It uses ASP.NET Core MVC
                    with C#, Entity Framework Core and SQL Server, Bootstrap for a responsive interface, and
                    OpenStreetMap (Leaflet) for map-based discovery of markets and stalls.
                </p>
                <p class="small mb-0">
                    <strong>AI tools used (acknowledgement):</strong> AI coding assistants were used for guidance,
                    debugging and productivity. The design, structure, database schema and implementation reflect our
                    own understanding and effort.
                </p>
            </div>
        </div>
    </div>
</div>
