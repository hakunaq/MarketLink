@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="ml-hero mb-4">
    <h1 class="display-5">Fresh from the farm, straight to you</h1>
    <p class="lead mb-4">Browse local farmers markets, reserve fresh produce and pay when you pick up.</p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning btn-lg fw-semibold">
            <i class="bi bi-search"></i> Browse Products
        </a>
        <a asp-controller="Markets" asp-action="Map" class="btn btn-outline-light btn-lg">
            <i class="bi bi-geo-alt"></i> Find Markets Near Me
        </a>
    </div>
</div>

@foreach (var a in Model.Announcements)
{
    <div class="alert alert-success d-flex align-items-center">
        <i class="bi bi-megaphone-fill me-2"></i>
        <div><strong>@a.Title:</strong> @a.Message</div>
    </div>
}

<div class="row g-3 mb-4 text-center">
    <div class="col-6 col-md-3">
        <div class="ml-stat"><div class="stat-value">@Model.FarmerCount</div><div class="stat-label">Local Farmers</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ml-stat amber"><div class="stat-value">@Model.ProductCount</div><div class="stat-label">Items Available</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ml-stat blue"><div class="stat-value">@Model.Markets.Count</div><div class="stat-label">Markets</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="ml-stat grey"><div class="stat-value">@Model.Categories.Count</div><div class="stat-label">Categories</div></div>
    </div>
</div>

<section class="mb-4">
    <h4 class="section-title mb-3">Shop by category</h4>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var c in Model.Categories)
        {
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@c.Id"
               class="btn btn-light border shadow-sm ml-badge-cat py-2 px-3">
                <i class="bi @c.IconClass me-1"></i> @c.Name
            </a>
        }
    </div>
</section>

<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="section-title mb-0">Fresh picks this week</h4>
        <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-success">View all</a>
    </div>
    <div class="row g-3">
        @foreach (var p in Model.FeaturedProducts)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
</section>

<section>
    <h4 class="section-title mb-3">Markets near you</h4>
    <div class="row g-3">
        @foreach (var m in Model.Markets)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="fw-bold"><i class="bi bi-shop text-success me-1"></i>@m.Name</h6>
                        <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@m.Address</p>
                        <p class="small mb-1"><i class="bi bi-calendar-week me-1"></i>@m.OperatingDays</p>
                        <p class="small mb-2"><i class="bi bi-clock me-1"></i>@m.OpenTime – @m.CloseTime</p>
                        <a asp-controller="Markets" asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-green">
                            View farmers <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
