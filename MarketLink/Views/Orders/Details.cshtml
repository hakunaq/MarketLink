@model Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">My Orders</a></li>
        <li class="breadcrumb-item active">#@Model.Id</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">Order #@Model.Id</h4>
                    <partial name="_OrderStatusBadge" model="Model.Status" />
                </div>
                <hr />
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("0.00")</td>
                                    <td class="fw-semibold">@item.LineTotal.ToString("0.00")</td>
                                    <td class="text-end">
                                        @if (Model.Status == OrderStatus.Completed && !item.IsReviewed)
                                        {
                                            <a asp-controller="Reviews" asp-action="Create"
                                               asp-route-orderItemId="@item.Id" asp-route-productId="@item.ProductId"
                                               class="btn btn-sm btn-outline-success"><i class="bi bi-star"></i> Review</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="3" class="text-end">Total</th><th colspan="2">@Model.TotalAmount.ToString("0.00")</th></tr>
                        </tfoot>
                    </table>
                </div>
                @if (!string.IsNullOrEmpty(Model.CustomerNote))
                {
                    <p class="small text-muted mt-2 mb-0"><strong>Your note:</strong> @Model.CustomerNote</p>
                }
            </div>
        </div>

        @if (Model.CanModify)
        {
            <div class="d-flex gap-2">
                <a asp-action="Modify" asp-route-id="@Model.Id" class="btn btn-outline-success"><i class="bi bi-pencil"></i> Modify order</a>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Cancel this order? Reserved stock will be released.');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Cancel order</button>
                </form>
            </div>
            <p class="small text-muted mt-2">Changes are allowed until @Model.CutoffTime.ToString("dd MMM yyyy, HH:mm") (UTC).</p>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-2">Pickup details</h6>
                <p class="small mb-1"><i class="bi bi-shop me-1 text-success"></i>@Model.Farmer?.StallName</p>
                <p class="small mb-1"><i class="bi bi-calendar me-1 text-success"></i>@Model.PickupDate.ToString("dd MMM yyyy")</p>
                <p class="small mb-1"><i class="bi bi-clock me-1 text-success"></i>@Model.PickupTimeSlot</p>
                @if (Model.Market != null)
                {
                    <p class="small mb-0"><i class="bi bi-geo-alt me-1 text-success"></i>@Model.Market.Name, @Model.Market.Address</p>
                }
                <div class="alert alert-light border small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>Pay in person when you collect.
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-2">Order timeline</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Placed on @Model.OrderDate.ToString("dd MMM yyyy")</li>
                    <li class="mb-1"><i class="bi @(Model.Status >= OrderStatus.Accepted ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1"></i>Accepted by farmer</li>
                    <li class="mb-1"><i class="bi @(Model.Status >= OrderStatus.ReadyForPickup ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1"></i>Ready for pickup</li>
                    <li><i class="bi @(Model.Status == OrderStatus.Completed ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1"></i>Completed</li>
                </ul>
            </div>
        </div>
    </div>
</div>
