@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0"><i class="bi bi-bell me-2"></i>Notifications</h2>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-success"><i class="bi bi-check2-all"></i> Mark all read</button>
        </form>
    }
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-bell-slash display-1 text-muted"></i>
        <p class="text-muted mt-2">No notifications yet.</p>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <div class="list-group-item @(n.IsRead ? "" : "bg-success-subtle")">
                <div class="d-flex justify-content-between">
                    <strong class="small">@n.Title</strong>
                    <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small>
                </div>
                <p class="small mb-1">@n.Message</p>
                @if (!string.IsNullOrEmpty(n.LinkUrl))
                {
                    <a href="@n.LinkUrl" class="small">Open <i class="bi bi-arrow-right"></i></a>
                }
            </div>
        }
    </div>
}
