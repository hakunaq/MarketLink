@model List<Product>
@{
    ViewData["Title"] = "My Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0"><i class="bi bi-box-seam me-2"></i>Weekly Stock</h2>
    <div>
        <a asp-controller="Farmer" asp-action="Index" class="btn btn-sm btn-light border"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <a asp-action="Create" class="btn btn-sm btn-green"><i class="bi bi-plus-circle"></i> Add product</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-box-seam display-1 text-muted"></i>
        <p class="text-muted mt-2">You haven't listed any products yet.</p>
        <a asp-action="Create" class="btn btn-green">Add your first product</a>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/products/placeholder.svg" : p.ImageUrl)"
                                         style="width:40px;height:40px;object-fit:cover;border-radius:.4rem" class="me-2" />
                                    <span class="fw-semibold small">@p.Name</span>
                                </div>
                            </td>
                            <td class="small">@p.Category?.Name</td>
                            <td class="small">@p.Price.ToString("0.00") / @p.Unit</td>
                            <td class="small">
                                @if (p.IsSoldOut)
                                {
                                    <span class="badge bg-secondary">Sold out</span>
                                }
                                else
                                {
                                    @p.StockQuantity
                                }
                            </td>
                            <td>
                                @if (!p.IsAvailable)
                                {
                                    <span class="badge bg-warning text-dark">Unavailable</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-light border" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="ToggleAvailable" asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary" title="Toggle availability"><i class="bi bi-power"></i></button>
                                </form>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
