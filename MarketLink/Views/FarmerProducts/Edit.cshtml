@model ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
}
<h2 class="section-title mb-3"><i class="bi bi-pencil me-2"></i>Edit Product</h2>
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <partial name="_ProductForm" model="Model" />
                    <div class="mt-3">
                        <button type="submit" class="btn btn-green">Update product</button>
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
