@model List<Announcement>
@{
    ViewData["Title"] = "Announcements";
}
<h2 class="section-title mb-3"><i class="bi bi-megaphone me-2"></i>Announcements</h2>
<partial name="_AdminNav" />

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light border">No announcements yet.</div>
        }
        else
        {
            foreach (var a in Model)
            {
                <div class="card mb-2 @(a.IsActive ? "" : "opacity-50")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h6 class="fw-bold mb-1">@a.Title</h6>
                            <span class="badge @(a.IsActive ? "bg-success" : "bg-secondary")">@(a.IsActive ? "Live" : "Hidden")</span>
                        </div>
                        <p class="small text-muted mb-2">@a.Message</p>
                        <div class="d-flex gap-2">
                            <form asp-action="ToggleAnnouncement" asp-route-id="@a.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary">@(a.IsActive ? "Hide" : "Show")</button>
                            </form>
                            <form asp-action="DeleteAnnouncement" asp-route-id="@a.Id" method="post"
                                  onsubmit="return confirm('Delete this announcement?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Publish announcement</h6>
                <form asp-action="AddAnnouncement" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label small">Title</label>
                        <input name="title" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Message</label>
                        <textarea name="message" class="form-control form-control-sm" rows="3" required></textarea>
                    </div>
                    <button class="btn btn-green btn-sm w-100"><i class="bi bi-send"></i> Publish</button>
                </form>
            </div>
        </div>
    </div>
</div>
