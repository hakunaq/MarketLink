@model List<Market>
@{
    ViewData["Title"] = "Manage Markets";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0"><i class="bi bi-geo-alt me-2"></i>Manage Markets</h2>
    <a asp-action="CreateMarket" class="btn btn-sm btn-green"><i class="bi bi-plus-circle"></i> Add market</a>
</div>
<partial name="_AdminNav" />

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr><th>Name</th><th>Address</th><th>Days</th><th>Hours</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.IsActive ? "" : "table-secondary")">
                        <td class="fw-semibold">@m.Name</td>
                        <td class="small">@m.Address</td>
                        <td class="small">@m.OperatingDays</td>
                        <td class="small">@m.OpenTime – @m.CloseTime</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Removed</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditMarket" asp-route-id="@m.Id" class="btn btn-sm btn-light border">Edit</a>
                            @if (m.IsActive)
                            {
                                <form asp-action="DeleteMarket" asp-route-id="@m.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this market?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
