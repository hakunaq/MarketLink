@model CreateReviewViewModel
@{
    ViewData["Title"] = "Write a Review";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="section-title mb-1"><i class="bi bi-star me-2"></i>Leave a review</h3>
                <p class="text-muted small mb-4">
                    @if (Model.ProductId.HasValue)
                    {
                        <text>For <strong>@Model.ProductName</strong> by @Model.FarmerName</text>
                    }
                    else
                    {
                        <text>For <strong>@Model.FarmerName</strong></text>
                    }
                </p>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="FarmerProfileId" />
                    <input type="hidden" asp-for="OrderItemId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your rating</label>
                        <div class="d-flex gap-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="Rating" id="rating@(i)" value="@i"
                                           checked="@(Model.Rating == i)" />
                                    <label class="form-check-label" for="rating@(i)">@i <i class="bi bi-star-fill star"></i></label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Comment" class="form-label fw-semibold">Comment</label>
                        <textarea asp-for="Comment" class="form-control" rows="4"
                                  placeholder="Share your experience with this product/farmer..."></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-green">Submit review</button>
                    <a href="javascript:history.back()" class="btn btn-light border">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
