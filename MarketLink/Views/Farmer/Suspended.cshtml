@{
    ViewData["Title"] = "Account Suspended";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h2 class="mt-3">Stall suspended</h2>
    <p class="text-muted">Your farmer stall has been temporarily suspended by an administrator.<br />Please contact support to resolve this.</p>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary">Log out</button>
    </form>
</div>
